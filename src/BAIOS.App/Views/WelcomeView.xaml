<UserControl x:Class="BAIOS.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
            <Image Source="pack://application:,,,/Assets/logo.png"
                   Width="88" Height="88" Margin="0,0,0,16"
                   HorizontalAlignment="Center"/>
            <TextBlock FontSize="36" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding ProductName}"/>
            <TextBlock Margin="0,8,0,0" FontSize="18" TextAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Text="{Binding Tagline}"/>
            <TextBlock Margin="0,16,0,0" TextAlignment="Center" Text="{Binding Version}"/>
            <TextBlock Margin="0,24,0,0" TextWrapping="Wrap" TextAlignment="Center">
                Orquesta diagnóstico, seguridad y mantenimiento.
                Licencia del motor:
                <Hyperlink Command="{Binding OpenLicenseCommand}">GNU GPL v3</Hyperlink>.
            </TextBlock>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center">
                Sitio web:
                <Hyperlink Command="{Binding OpenWebsiteCommand}">sites.google.com/view/blinter-baios</Hyperlink>
            </TextBlock>
            <Button Margin="0,32,0,0" HorizontalAlignment="Center" Content="Continuar" Command="{Binding ContinueCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
