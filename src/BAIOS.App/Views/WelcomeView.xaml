<UserControl x:Class="BAIOS.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48">
        <StackPanel VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
            <Image Source="/Assets/logo.png" Width="72" Height="72" Margin="0,0,0,16"/>
            <TextBlock FontSize="36" FontWeight="SemiBold" Text="{Binding ProductName}"/>
            <TextBlock Margin="0,8,0,0" FontSize="18" Foreground="{StaticResource MutedBrush}" Text="{Binding Tagline}"/>
            <TextBlock Margin="0,16,0,0" Text="{Binding Version}"/>
            <TextBlock Margin="0,24,0,0" TextWrapping="Wrap">
                Orquesta diagnóstico, seguridad y mantenimiento.
                Licencia del motor:
                <Hyperlink Command="{Binding OpenLicenseCommand}">GNU GPL v3</Hyperlink>.
            </TextBlock>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                Sitio web:
                <Hyperlink Command="{Binding OpenWebsiteCommand}">github.com/andago9/BAIOS</Hyperlink>.
            </TextBlock>
            <Button Margin="0,32,0,0" HorizontalAlignment="Left" Content="Continuar" Command="{Binding ContinueCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
