<UserControl x:Class="BAIOS.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Seguridad"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
            </DockPanel>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Microsoft Defender"/>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Defender.Summary}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding IsTechnician, Converter={StaticResource BoolToVis}}"
                               Text="{Binding Defender.LastQuickScan, StringFormat=Último análisis rápido: {0}}"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="No se recomienda desactivar Defender de forma permanente."/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Firewall"/>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Firewall.Summary}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Firewall.Detail}"
                               Visibility="{Binding IsTechnician, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <WrapPanel>
                <Button Content="Análisis rápido" Command="{Binding QuickScanCommand}"/>
                <Button Content="Análisis completo" Command="{Binding FullScanCommand}"/>
                <Button Content="Sin conexión (reinicia)" Command="{Binding OfflineScanCommand}"/>
            </WrapPanel>
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding OfflineHint}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,16,0,0" Text="{Binding LastAction}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
