<UserControl x:Class="BAIOS.App.Views.ModeSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48">
        <StackPanel MaxWidth="760" VerticalAlignment="Center">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="¿Cómo quieres trabajar?"/>
            <TextBlock Margin="0,8,0,24" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding Hint}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Text="Sugerido"
                                   Visibility="{Binding SuggestHome, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Hogar"/>
                        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Dashboard claro, alertas y acciones seguras. Pocas herramientas externas."/>
                        <Button Content="Entrar como Hogar" Command="{Binding ChooseHomeCommand}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Text="Sugerido"
                                   Visibility="{Binding SuggestTechnician, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Técnico"/>
                        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="El mismo motor, más detalle, códigos de salida y diagnóstico completo hasta el reporte."/>
                        <Button Content="Entrar como Técnico" Command="{Binding ChooseTechnicianCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
