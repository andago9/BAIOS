<UserControl x:Class="BAIOS.App.Views.AgreementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/logo.png"
                   Width="64" Height="64" Margin="0,0,0,16"
                   HorizontalAlignment="Center"/>
            <TextBlock FontSize="28" FontWeight="SemiBold" TextAlignment="Center" Text="Acuerdo de uso"/>
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Text="BAIOS no es un antivirus. Orquesta el estado del equipo y lanza herramientas propias o de terceros. Cada fabricante conserva su licencia y su EULA."/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Algunos motores marcan archivos de sistema como sospechosos (falsos positivos). No elimines archivos sin saber qué son. No borres a ciegas cuarentenas ni entradas de inicio."/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Text="BAIOS y Andago no se hacen responsables de lo que hagas dentro de las herramientas propias o de terceros. El uso es bajo tu responsabilidad."/>
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center">
                Sitio web:
                <Hyperlink Command="{Binding OpenWebsiteCommand}">sites.google.com/view/blinter-baios</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center">
                Si tienes dudas, consulta el
                <Hyperlink Command="{Binding OpenForumCommand}">foro (Issues en GitHub)</Hyperlink>.
            </TextBlock>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       Text="Si no aceptas, no se cierra la aplicación: simplemente no entrarás al motor."/>
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0" HorizontalAlignment="Center">
                <Button Content="Acepto" Command="{Binding AcceptCommand}"/>
                <Button Style="{StaticResource GhostButton}" Content="No acepto" Command="{Binding DeclineCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
