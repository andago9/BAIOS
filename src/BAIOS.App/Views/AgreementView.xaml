<UserControl x:Class="BAIOS.App.Views.AgreementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Acuerdo de uso"/>
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                       Text="BAIOS no es un antivirus. Orquesta el estado del equipo y lanza herramientas propias o de terceros. Cada fabricante conserva su licencia y su EULA."/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="Algunos motores marcan archivos de sistema como sospechosos (falsos positivos). No elimines archivos sin saber qué son. No borres a ciegas cuarentenas ni entradas de inicio."/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="BAIOS y Andago no se hacen responsables de lo que hagas dentro de las herramientas propias o de terceros. El uso es bajo tu responsabilidad."/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                Si tienes dudas, consulta el
                <Hyperlink Command="{Binding OpenForumCommand}">foro (Issues en GitHub)</Hyperlink>.
            </TextBlock>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="Si no aceptas, no se cierra la aplicación: simplemente no entrarás al motor."/>
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button Content="Acepto" Command="{Binding AcceptCommand}"/>
                <Button Style="{StaticResource GhostButton}" Content="No acepto" Command="{Binding DeclineCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
