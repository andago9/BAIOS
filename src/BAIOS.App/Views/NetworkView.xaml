<UserControl x:Class="BAIOS.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Red"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
        </DockPanel>
        <ScrollViewer>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding HomeLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,4" Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,16,0,8">
                    <Button Content="Flush DNS" Command="{Binding FlushCommand}"/>
                    <Button Content="Renovar DHCP" Command="{Binding RenewCommand}"/>
                    <Button Content="Tracert 1.1.1.1" Command="{Binding TraceCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Last}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,16,0,8" FontWeight="SemiBold" Text="Adaptadores"
                           Visibility="{Binding IsTechnician, Converter={StaticResource BoolToVis}}"/>
                <DataGrid Height="160" ItemsSource="{Binding Snapshot.Adapters}"
                          Visibility="{Binding IsTechnician, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding AddressText}" Width="180"/>
                    <DataGridTextColumn Header="DNS" Binding="{Binding DnsText}" Width="180"/>
                    <DataGridTextColumn Header="Gateway" Binding="{Binding GatewayText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Margin="0,16,0,8" FontWeight="SemiBold" Text="Salida de tracert"
                           Visibility="{Binding IsTechnician, Converter={StaticResource BoolToVis}}"/>
                <TextBox MinHeight="180" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         FontFamily="Consolas" Text="{Binding TraceOutput, Mode=OneWay}"
                         Visibility="{Binding IsTechnician, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
